from classes import *
def show_menu():
    print("\n" + "=" * 40)
    print("       HOSPITAL MANAGEMENT SYSTEM")
    print("=" * 40)
    print("1. Add Department")
    print("2. Add Patient")
    print("3. Add Staff")
    print("4. View Departments")
    print("5. View Patients")
    print("6. View Staff")
    print('7. search')
    print("8. Exit")

#exit
    def exit_system():
    print("Exiting Hospital Management System...")
    return True


def main():
    hospital_name = input("Enter hospital name: ")
    hospital_location = input("Enter hospital location: ")
    hospital = Hospital(hospital_name, hospital_location)
    print("\nHospital created successfully!")
    while True:
        show_menu()
        choice = input("\nEnter your choice: ")
    # 1. Add Department

    Departments = []
    def Add_Department(hospital_name):
        Dep = input("Enter department name:")   
        Departments.append(Dep)
        print(f"Department '{Dep}' added to {hospital_name} ")
        print("Department added successfuly!")
    
    
    
    
